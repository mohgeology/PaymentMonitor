<Window x:Class="PaymentMonitor.Cashier.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الشبكة"
        Width="480" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#123B7A"
        FontFamily="Segoe UI">

    <Border Margin="20" Background="White" CornerRadius="12" Padding="20">
        <StackPanel>

            <TextBlock Text="🌐 إعدادات الشبكة"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#123B7A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="عنوان السيرفر:"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#123B7A"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="ServerUrlBox"
                     FontSize="14"
                     Padding="10"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,16"
                     Text="http://192.168.1.70:5000"/>

            <TextBlock Text="حالة الاتصال:"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#123B7A"
                       Margin="0,0,0,4"/>

            <TextBlock x:Name="StatusText"
                       Text="—"
                       FontSize="13"
                       Foreground="#666666"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <Button x:Name="TestBtn"
                    Content="🔌 اختبار الاتصال"
                    Height="40"
                    Background="#F07C22"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    Margin="0,0,0,10"
                    Click="TestBtn_Click"/>

            <Button x:Name="SaveBtn"
                    Content="💾 حفظ وإعادة الاتصال"
                    Height="40"
                    Background="#123B7A"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    Margin="0,0,0,10"
                    Click="SaveBtn_Click"/>

            <Button x:Name="CloseBtn"
                    Content="إغلاق"
                    Height="35"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="CloseBtn_Click"/>

        </StackPanel>
    </Border>
</Window>
