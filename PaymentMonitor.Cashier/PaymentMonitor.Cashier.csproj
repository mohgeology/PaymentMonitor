<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PaymentMonitor.Cashier</AssemblyName>
    <RootNamespace>PaymentMonitor.Cashier</RootNamespace>
    <Version>1.0.0</Version>
    <Company>PaymentMonitor</Company>
    <Product>PaymentMonitor Cashier</Product>
    <AssemblyTitle>PaymentMonitor Cashier</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Self-contained publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Suppress warnings -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
