<Window x:Class="PaymentMonitor.ServerManager.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ربط التطبيق"
        Width="520" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#123B7A"
        FontFamily="Segoe UI">

    <Border Margin="20" Background="White" CornerRadius="12" Padding="24">
        <StackPanel>

            <TextBlock Text="📱 ربط التطبيق"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#123B7A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock Text="امسح هذا الرمز من التطبيق لربطه بالسيرفر تلقائيًا"
                       FontSize="13"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <Border Background="#F5F8FF"
                    CornerRadius="10"
                    Padding="16"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <Image x:Name="QrImage"
                       Width="300"
                       Height="300"
                       Stretch="Uniform"/>
            </Border>

            <TextBlock Text="عنوان السيرفر:"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#123B7A"
                       Margin="0,0,0,4"/>

            <Border Background="#F5F8FF"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,8">
                <TextBlock x:Name="ServerUrlText"
                           FontSize="13"
                           Foreground="#123B7A"
                           FontFamily="Consolas"
                           TextAlignment="Center"/>
            </Border>

            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Button Content="🔄 تحديث"
                    Height="38"
                    Background="#F07C22"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Refresh_Click"
                    Margin="0,0,0,8"/>

            <Button Content="إغلاق"
                    Height="35"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Close_Click"/>

        </StackPanel>
    </Border>
</Window>
