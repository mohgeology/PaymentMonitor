<Window x:Class="PaymentMonitor.ServerManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات السيرفر"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#123B7A"
        FontFamily="Segoe UI">

    <Border Margin="20" Background="White" CornerRadius="12" Padding="20">
        <StackPanel>

            <TextBlock Text="⚙ إعدادات السيرفر"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#123B7A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="مجلد السيرفر (يحتوي main.py):"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#123B7A"
                       Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerFolderBox"
                         Grid.Column="0"
                         FontSize="13"
                         Padding="8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>
                <Button Grid.Column="1"
                        Content="..."
                        Width="40"
                        Margin="6,0,0,0"
                        Click="BrowseServerFolder_Click"
                        Background="#123B7A"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>

            <TextBlock Text="مسار Python (pythonw.exe):"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#123B7A"
                       Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PythonPathBox"
                         Grid.Column="0"
                         FontSize="13"
                         Padding="8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>
                <Button Grid.Column="1"
                        Content="..."
                        Width="40"
                        Margin="6,0,0,0"
                        Click="BrowsePythonPath_Click"
                        Background="#123B7A"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>

            <TextBlock Text="المنفذ:"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#123B7A"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="PortBox"
                     FontSize="13"
                     Padding="8"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Text="5000"
                     Width="120"
                     HorizontalAlignment="Right"
                     Margin="0,0,0,20"/>

            <Button Content="💾 حفظ"
                    Height="40"
                    Background="#F07C22"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    Click="SaveBtn_Click"
                    Margin="0,0,0,8"/>

            <Button Content="إغلاق"
                    Height="35"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="CloseBtn_Click"/>

        </StackPanel>
    </Border>
</Window>
